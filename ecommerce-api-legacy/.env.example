# Porta HTTP (padrão: 3000)
PORT=3000

# Arquivo SQLite (padrão: :memory:, recriado e populado a cada boot)
DB_FILE=:memory:

# Chave do gateway de pagamento. Obrigatória com NODE_ENV=production;
# fora de produção, um valor efêmero é gerado no boot.
PAYMENT_GATEWAY_KEY=pk_test_change_me

# Opcional. Quando definido, as rotas administrativas
# (GET /api/admin/financial-report, DELETE /api/users/:id) exigem o header
# X-Admin-Token com este valor (401 sem ele). Sem ele, fora de produção essas
# rotas respondem como sempre; com NODE_ENV=production, respondem 403.
ADMIN_TOKEN=change_me_to_a_long_random_value

# debug | info | warn | error (padrão: info)
LOG_LEVEL=info

NODE_ENV=development
