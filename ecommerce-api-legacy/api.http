@baseUrl = http://localhost:3000
@adminToken = change_me_to_a_long_random_value

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

# Rotas administrativas: se ADMIN_TOKEN estiver definido no servidor, adicione
# o header "X-Admin-Token: {{adminToken}}" às duas requisições abaixo.

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
