# Copie para .env e ajuste. Nenhuma variável é obrigatória em desenvolvimento.

# development | production (em production, SECRET_KEY é obrigatória e rotas admin sem ADMIN_TOKEN respondem 403)
APP_ENV=development

# Chave para assinar tokens de login. Sem ela, fora de produção, é gerada uma chave efêmera a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Banco de dados (padrão: SQLite em instance/tasks.db)
DATABASE_URL=sqlite:///tasks.db

# Servidor
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Origens liberadas no CORS, separadas por vírgula (padrão: *)
CORS_ORIGINS=http://localhost:3000

# Quando definido, /reports/*, DELETE /users/<id> e a atribuição de role (POST/PUT /users)
# exigem o header X-Admin-Token com este valor.
ADMIN_TOKEN=troque-por-um-token-de-admin
