# Ambiente: development | production (em production SECRET_KEY é obrigatória)
APP_ENV=development
# Chave de assinatura do Flask; sem ela, fora de produção, um valor efêmero é gerado
SECRET_KEY=troque-por-um-valor-aleatorio
DEBUG=false
HOST=0.0.0.0
PORT=5000
DATABASE_PATH=loja.db
# Origens permitidas no CORS, separadas por vírgula ("*" libera todas)
CORS_ORIGINS=*
# Token exigido no header X-Admin-Token pelas rotas /admin/*; vazio desabilita as rotas (403)
ADMIN_TOKEN=
